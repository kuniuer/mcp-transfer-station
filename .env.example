# Template only. Configure these in PHP-FPM / web-server environment; PHP does not load this file automatically.
GITHUB_TOKEN=replace_with_fine_grained_token
GITHUB_REPO=kuniuer/mcp-transfer-station
GITHUB_BRANCH=main
UPLOAD_KEY=replace_with_a_long_random_secret
MAX_UPLOAD_BYTES=6291456
# Optional: exact page origin if the webpage and PHP endpoint use different domains.
UPLOAD_ALLOWED_ORIGIN=
# Optional: keep logs outside the public web directory.
UPLOAD_LOG_FILE=/var/log/github-image-upload-log.jsonl
